# Required for hitch_chat_completions (and preferred for hitch_list_models).
# Hitch Bearer key. Unexpanded ${HITCH_API_KEY} is treated as missing.
HITCH_API_KEY=

# Optional fallback if HITCH_API_KEY is unset.
# OPENAI_API_KEY=

# Optional. Default: https://hitch.genoventures.com/v1
# Include /v1 once; trailing slash is stripped. Do not set .../v1/v1.
# HITCH_BASE_URL=https://hitch.genoventures.com/v1
