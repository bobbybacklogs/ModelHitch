{
  "name": "modelhitch",
  "version": "0.15.2",
  "description": "Plug-and-play BYOK integration layer — hitch any AI provider or model to your app.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "modelhitch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/quickstart.ts",
    "bridge": "tsx examples/studio-bridge.ts",
    "canary": "tsx examples/canary.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "gh-release": "node scripts/gh-release.mjs",
    "release": "npm version patch && npm publish && git push origin main --tags && npm run gh-release",
    "release:minor": "npm version minor && npm publish && git push origin main --tags && npm run gh-release",
    "release:major": "npm version major && npm publish && git push origin main --tags && npm run gh-release"
  },
  "keywords": [
    "ai",
    "llm",
    "byok",
    "bring-your-own-key",
    "provider",
    "openai",
    "anthropic",
    "ollama",
    "groq",
    "huggingface",
    "gemini",
    "deepseek",
    "xai",
    "mistral",
    "moonshot",
    "zai",
    "openrouter",
    "vercel-ai-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genoventures-labs/ModelHitch.git"
  },
  "homepage": "https://github.com/genoventures-labs/ModelHitch#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6",
    "mdev-sdk": "^0.1.0"
  }
}
